# === Local Database / Container Volumes ===
# Prevents committing local data folders if you map directories instead of named volumes
.data/
data/
*.db
*.sqlite

# === Environment & Secrets ===
# Never commit credentials or API keys to source control
.env
.env.local
.env.*.local
*.env

# === Dependency Directories ===
# Node.js dependencies
node_modules/
jspm_packages/
.pnpm-store/

# Python dependencies
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/

# Go dependencies
vendor/

# === IDEs and Editors ===
# Visual Studio Code
.vscode/
!.vscode/extensions.json
*.code-workspace

# JetBrains (WebStorm, PyCharm, IntelliJ, etc.)
.idea/

# Local history / backups
.history/
*.suo
*.ntvs*
*.njsproj
*.sln

# === OS Files ===
# Windows systems
Thumbs.db
ehthumbs.db
Desktop.ini

# macOS systems
.DS_Store
.AppleDouble
.LSOverride

# === Logs & Diagnostics ===
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*